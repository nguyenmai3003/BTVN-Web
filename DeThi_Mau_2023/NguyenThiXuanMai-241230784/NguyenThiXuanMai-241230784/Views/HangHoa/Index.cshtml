@model IEnumerable<NguyenThiXuanMai_241230784.Models.HangHoa>
@{
    ViewData["Title"] = "Trang chủ";

}
<div id="mainContent"> 
<partial name="NguyenThiXuanMai_MainContent" model="Model" />
</div>
@section Scripts {
    <script>
        $(function () {
            $('.loai-hang').click(function (event) {
                event.preventDefault();

                var lienKet = $(this);

                $.ajax({
                    url: '@Url.Action("RenderByID", "HangHoa")',
                    type: 'GET',
                    data: { id: lienKet.data('id') },

                    success: function (data) {
                        $('#mainContent').html(data);

                        $('.menu li').removeClass('active');
                        lienKet.parent().addClass('active');
                    },

                    error: function () {
                        alert('Không tải được danh sách hàng hóa.');
                    }
                });
            });
        });
    </script>
}
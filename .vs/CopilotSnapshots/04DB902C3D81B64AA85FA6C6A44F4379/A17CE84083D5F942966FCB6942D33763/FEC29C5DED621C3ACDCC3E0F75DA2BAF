@model IEnumerable<Learner>
@{
    ViewData["Title"] = "Danh sách người học";
    int? selectedMajorId = ViewBag.SelectedMajorId;
    bool useAjax = ViewBag.UseAjax;
}
<div class="ms-2 mx-2">
    <h1>Danh sách người học</h1>
    <p class="text-muted">Chọn chuyên ngành để lọc danh sách người học.</p>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span>Cách tải dữ liệu:</span>
        <div class="btn-group" role="group" aria-label="Cách tải dữ liệu">
            <a asp-action="Index" asp-route-mid="@selectedMajorId" asp-route-useAjax="false"
               data-load-mode="false" class="btn btn-outline-primary @(!useAjax ? "active" : "")"
               aria-current="@(!useAjax ? "page" : null)">Tải lại trang</a>
            <a asp-action="Index" asp-route-mid="@selectedMajorId" asp-route-useAjax="true"
               data-load-mode="true" class="btn btn-outline-primary @(useAjax ? "active" : "")"
               aria-current="@(useAjax ? "page" : null)">AJAX</a>
        </div>
    </div>

    @await Component.InvokeAsync("Major", new { selectedMajorId, useAjax })

    <p id="filter-status" class="small text-muted" role="status"></p>
    <div id="filter-error" class="alert alert-danger" role="alert" hidden></div>
    <div id="content" aria-live="polite" aria-busy="false">
        <partial name="LearnerTable" model="Model" />
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm người học</a>
</div>

@section Scripts {
    <script src="~/js/learner-filter.js" asp-append-version="true"></script>
}

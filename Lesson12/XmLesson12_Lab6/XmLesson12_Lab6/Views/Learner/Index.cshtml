@model LearnerListViewModel
@{
    ViewData["Title"] = "Learner List";
    int? selectedMajorId = Model.MajorId;
    bool useAjax = Model.UseAjax;
}
<div class="ms-2 mx-2">
    <h1>Learner List</h1>
    <p class="text-muted">Filter by major, search by name, and browse the list by page.</p>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span>Data loading method:</span>
        <div class="btn-group" role="group" aria-label="Data loading method">
            <a asp-action="Index" asp-route-mid="@selectedMajorId" asp-route-useAjax="false"
               asp-route-keyword="@Model.Keyword" asp-route-pageIndex="@Model.PageIndex"
               data-load-mode="false" class="btn btn-outline-primary @(!useAjax ? "active" : "")"
                aria-current="@(!useAjax ? "page" : null)">Reload Page</a>
            <a asp-action="Index" asp-route-mid="@selectedMajorId" asp-route-useAjax="true"
               asp-route-keyword="@Model.Keyword" asp-route-pageIndex="@Model.PageIndex"
               data-load-mode="true" class="btn btn-outline-primary @(useAjax ? "active" : "")"
               aria-current="@(useAjax ? "page" : null)">AJAX</a>
        </div>
    </div>

    @await Component.InvokeAsync("Major", new { selectedMajorId, useAjax, keyword = Model.Keyword })

    <form id="learner-search" asp-controller="Learner" asp-action="Index" method="get" class="mb-3" style="max-width: 440px">
        <input type="hidden" name="mid" value="@Model.MajorId" />
        <input type="hidden" name="useAjax" value="@useAjax.ToString().ToLowerInvariant()" />
        <label for="keyword" class="form-label">Search by learner name</label>
        <div class="input-group">
            <input id="keyword" name="keyword" value="@Model.Keyword" type="search"
                   class="form-control" placeholder="Enter a learner name…" />
            <button id="btnSearch" class="btn btn-primary" type="submit">Search</button>
        </div>
    </form>

    <p id="filter-status" class="small text-muted" role="status"></p>
    <div id="filter-error" class="alert alert-danger" role="alert" hidden></div>
    <div id="content" aria-live="polite" aria-busy="false">
        <partial name="LearnerTable" model="Model" />
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Learner</a>
</div>

@section Scripts {
    <script src="~/js/learner-filter.js" asp-append-version="true"></script>
}

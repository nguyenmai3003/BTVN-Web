@{
    var isCreate = ViewContext.RouteData.Values["controller"]?.ToString() == "Learner"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Create";
}
<nav class="sb-sidenav accordion sb-sidenav-dark" aria-label="Main menu">
    <div class="sb-sidenav-menu">
        <div class="nav">
            <div class="sb-sidenav-menu-heading">Overview</div>
            <a class="nav-link @(!isCreate ? "active" : "")" asp-controller="Learner" asp-action="Index"
               aria-current="@(!isCreate ? "page" : null)">
                <span class="sb-nav-link-icon" aria-hidden="true">☷</span>
                Learner List
            </a>
            <div class="sb-sidenav-menu-heading">Management</div>
            <a class="nav-link @(isCreate ? "active" : "")" asp-controller="Learner" asp-action="Create"
               aria-current="@(isCreate ? "page" : null)">
                <span class="sb-nav-link-icon" aria-hidden="true">＋</span>
                Add Learner
            </a>
        </div>
    </div>
    <div class="sb-sidenav-footer">
        <div class="small">Xuan Mai · Lab 5</div>
        ASP.NET Core MVC
    </div>
</nav>

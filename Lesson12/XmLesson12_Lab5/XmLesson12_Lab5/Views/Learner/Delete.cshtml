@{
    ViewData["Title"] = "Delete Learner";
}
@model Learner

<div class="ms-2 mx-2">
    <h1>Delete Learner</h1>
    <div asp-validation-summary="All" class="text-danger"></div>
    @if (!Model.Enrollments.Any())
    {
        <p>Are you sure you want to delete this learner?</p>
    }
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FirstMidName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FirstMidName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LastName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LastName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MajorID)
        </dt>
        <dd class="col-sm-10">
            @Model.Major?.MajorName
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EnrollmentDate)
        </dt>
        <dd class="col-sm-10">
            @Model.EnrollmentDate.ToString("dd/MM/yyyy")
        </dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.LearnerID" method="post">
        <input type="hidden" asp-for="LearnerID" />
        @if (!Model.Enrollments.Any())
        {
            <button type="submit" class="btn btn-danger">Delete Learner</button>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    </form>
</div>
